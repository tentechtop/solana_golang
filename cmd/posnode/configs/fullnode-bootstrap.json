  "peer_seed": "replace-with-high-entropy-private-seed",
  "node_features": {
    "bootnode_enabled": true,
    "archive_enabled": true,
    "wallet_pairing_enabled": false
  },
  "consensus_policy": {
    "multi_validator_threshold": 4
  },
  "emergency_recovery": {
    "enabled": true
  },
  "bootstrap_coordinator": {
    "enabled": true,
    "min_validators": 1,
    "genesis_start_delay_millis": 30000,
    "registry_path": "data/fullnode-bootstrap-01/bootstrap-registry.json"
  },
  "genesis": {
    "initial_supply_lamports": 100000000000000000,
    "funded_accounts": [],
    "initial_validators": []
  }
