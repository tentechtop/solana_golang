{
  "node_mode": "fullnode",
  "chain_id": "replace-with-your-network-id",
  "environment": "stage",
  "production": false,
  "node_name": "fullnode-bootstrap-01",
  "data_path": "data/fullnode-bootstrap-01",
  "listen_ip": "0.0.0.0",
  "listen_port": 5101,
  "network": "tcp",
  "advertised_ip": "replace-with-public-ipv4",
  "advertised_port": 5101,
  "rpc_enabled": true,
  "rpc_listen_ip": "0.0.0.0",
  "rpc_port": 8899,
