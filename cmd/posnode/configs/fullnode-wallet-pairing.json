{
  "node_mode": "fullnode",
  "environment": "stage",
  "production": false,
  "node_name": "fullnode-02",
  "data_path": "data/fullnode-02",
  "listen_ip": "0.0.0.0",
  "listen_port": 5102,
  "network": "tcp",
  "advertised_ip": "replace-with-public-ipv4",
  "advertised_port": 5102,
  "rpc_enabled": true,
  "rpc_listen_ip": "0.0.0.0",
  "rpc_port": 8902,
  "allow_insecure_p2p": false,
  "peer_seed": "replace-with-high-entropy-private-seed",
  "node_features": {
    "bootnode_enabled": true,
    "wallet_pairing_enabled": true
  },
  "consensus_policy": {
    "multi_validator_threshold": 4
  },
  "emergency_recovery": {
    "enabled": true
  },
  "bootstrap_join": {
    "rpc_url": "http://replace-with-bootstrap-host:8899/",
    "poll_interval_millis": 2000,
    "timeout_millis": 0
  },
  "genesis": {
    "initial_supply_lamports": 100000000000000000,
    "funded_accounts": [],
    "initial_validators": []
  }
}
